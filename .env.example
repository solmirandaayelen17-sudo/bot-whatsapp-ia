# Copiá este archivo como ".env" y completá los valores.
# El .env NUNCA se sube a GitHub (ya está en .gitignore): tiene claves privadas.

# --- IA (Gemini) ---
# Gratis en https://aistudio.google.com/apikey
# Ojo: en el nivel gratis, Google puede usar lo que mandás para mejorar sus
# productos. Para pruebas con datos inventados está bien; con clientes reales,
# activá la facturación.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Opcional: modelos que se usan si el principal falla (saturado o sin cuota).
# Podés poner varios separados por coma.
GEMINI_MODEL_RESPALDO=gemini-3.5-flash-lite
# Poné DEBUG=1 si querés ver el detalle completo de los errores.
DEBUG=

# --- Google Sheets (solo si una empresa usa "tipo": "google-sheets") ---
# Ruta al archivo .json de la cuenta de servicio. Guardalo en la carpeta
# credenciales/ (también está ignorada por git).
GOOGLE_APPLICATION_CREDENTIALS=./credenciales/cuenta-servicio.json

# --- WhatsApp Cloud API (solo para el modo servidor) ---
# Token de acceso de tu app (en el panel de Meta: WhatsApp > Configuración de la API).
WHATSAPP_TOKEN=
# Una palabra secreta que inventás vos y cargás igual en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# "Clave secreta de la app" (App Secret): Configuración de la app > Básica.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0

# --- Mercado Pago (solo si una empresa tiene "cobrar_mercado_pago") ---
# Access Token de la cuenta que cobra. Para probar sin plata real, usá el de una
# CUENTA DE PRUEBA vendedora (ver README, "Cobrar con Mercado Pago").
MERCADOPAGO_ACCESS_TOKEN=

PORT=3000
